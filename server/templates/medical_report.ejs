<!DOCTYPE html>
<html>
<head>
<style>
    @page {
        size: A4;
        margin: 15mm 12mm;
        background-color: #fdfbf7;
    }
    *, *::before, *::after { box-sizing: border-box; }
    body {
        font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
        margin: 0;
        padding: 0;
        color: #334155;
        font-size: 11pt;
        background-color: #fdfbf7;
    }
    .header {
        border-bottom: 2px solid #0f172a;
        padding-bottom: 10px;
        margin-bottom: 20px;
    }
    h1 { font-size: 22pt; color: #0f172a; margin: 0; }
    h2 { font-size: 13pt; color: #0ea5e9; border-bottom: 1px solid #cbd5e1; padding-bottom: 4px; margin-top: 24px; text-transform: uppercase; letter-spacing: 0.5px;}
    .patient-info {
        width: 100%;
        border-collapse: collapse;
        margin-bottom: 20px;
    }
    .patient-info td { padding: 8px 0; border-bottom: 1px dashed #e2e8f0; }
    .label { font-weight: bold; width: 120px; color: #64748b; }
    .box {
        background-color: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        padding: 15px;
        margin-bottom: 15px;
    }
    table.data-table { width: 100%; border-collapse: collapse; margin-top: 5px; }
    table.data-table th, table.data-table td {
        text-align: left;
        padding: 10px;
        border-bottom: 1px solid #f1f5f9;
    }
    table.data-table th { background-color: #f8fafc; color: #475569; font-size: 10pt; font-weight: bold; }
    .badge {
        background-color: #dcfce7;
        color: #166534;
        padding: 3px 8px;
        border-radius: 12px;
        font-size: 9pt;
        font-weight: bold;
    }
    .footer { position: absolute; bottom: 0; left: 0; right: 0; text-align: center; font-size: 9pt; color: #94a3b8; border-top: 1px solid #e2e8f0; padding-top: 10px;}
</style>
</head>
<body>
    <div class="header">
        <h1>HealthEase Medical Record</h1>
        <p style="margin: 5px 0 0 0; color: #64748b;">Generated: <%= new Date().toLocaleDateString() %></p>
    </div>

    <h2>Patient Information</h2>
    <table class="patient-info">
        <tr>
            <td class="label">Name:</td>
            <td><%= patient.name %></td>
            <td class="label">Status:</td>
            <td><span class="badge">Active</span></td>
        </tr>
        <tr>
            <td class="label">Patient ID:</td>
            <td><%= patient._id %></td>
            <td class="label">Email:</td>
            <td><%= patient.email %></td>
        </tr>
    </table>

    <h2>Recent Vitals Summary</h2>
    <div class="box">
        <% if (patient.healthProfile && patient.healthProfile.vitals && patient.healthProfile.vitals.length > 0) { %>
            <table class="data-table">
                <tr><th>Date</th><th>Heart Rate</th><th>Blood Pressure</th><th>Weight</th><th>Status</th></tr>
                <% patient.healthProfile.vitals.slice(0, 5).forEach(function(vital) { %>
                <tr>
                    <td><%= new Date(vital.date).toLocaleDateString() %></td>
                    <td><%= vital.heartRate || '--' %> bpm</td>
                    <td><%= vital.bloodPressure || '--' %></td>
                    <td><%= vital.weight || '--' %> kg</td>
                    <td><span class="badge">Stable</span></td>
                </tr>
                <% }); %>
            </table>
        <% } else { %>
            <p>No recent vitals recorded.</p>
        <% } %>
    </div>

    <h2>Active Medications</h2>
    <div class="box">
        <% if (patient.medications && patient.medications.length > 0) { %>
            <table class="data-table">
                <tr><th>Medication</th><th>Dosage</th><th>Frequency</th></tr>
                <% patient.medications.forEach(function(med) { %>
                <tr>
                    <td><%= med.name %></td>
                    <td><%= med.dosage %></td>
                    <td><%= med.frequency %></td>
                </tr>
                <% }); %>
            </table>
        <% } else { %>
            <p>No active medications recorded.</p>
        <% } %>
    </div>

    <div class="footer">
        Confidential Medical Record - HealthEase Platform - Page 1 of 1
    </div>
</body>
</html>
